# =============================================================================
# Dearr V1 — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real credentials.
# =============================================================================

# --- Hostinger MySQL Database ------------------------------------------------
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Session Security --------------------------------------------------------
# Generate a strong random string (minimum 32 characters).
# Example: openssl rand -base64 32
AUTH_SECRET=
SESSION_SECRET=

# --- Razorpay Payment Gateway ------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Application URL ---------------------------------------------------------
# Use http://localhost:3000 for local development.
# Update to the production domain before deployment.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Google OAuth ------------------------------------------------------------
# Register credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs must include:
#   Local:      http://localhost:3000/api/auth/google/callback
#   Production: https://dearr.in/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# --- Resend Transactional Email -----------------------------------------------
# Server-only API key generated from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Authorized verified sender address (Domain must be verified in Resend)
RESEND_FROM_EMAIL=Dearr <notifications@dearr.in>
# Master toggle: set to 'true' only when domain is verified and sending is active
RESEND_EMAILS_ENABLED=false
# Optional daily budget cap safeguarding provider free-tier allowance (default: 80)
RESEND_DAILY_BUDGET_CAP=80
